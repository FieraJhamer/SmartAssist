# Credenciales para el administrador inicial.
# Cópialas al archivo .env y cambialos por valores seguros ANTES de la primera ejecución.
# El usuario solo se crea una vez; si ya existe en la base, debés eliminarlo para regenerarlo.
SMARTASSIST_ADMIN_USUARIO=admin
SMARTASSIST_ADMIN_CLAVE=admin123

# Sesión persistente (token en la URL)
SMARTASSIST_SESSION_HORAS=8
# Secreto para firmar el token de sesión. Cambialo por algo largo y aleatorio en producción.
SMARTASSIST_SESSION_SECRET=cambiar-este-secreto-en-produccion